# =====================================================================
# Vachan configuration. Copy to backend/.env and fill in what you have.
# Anything left empty falls back to a local mode, so the app always runs.
# =====================================================================

# ---------- Lyzr (multi-agent orchestration) ----------
# studio.lyzr.ai -> sign in -> API key (account/settings menu)
LYZR_API_KEY=
# Copy the exact URL from an agent's "Agent API" panel in Lyzr Studio
LYZR_CHAT_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
# Create these 6 agents in Lyzr Studio (prompts in backend/app/agents/*.md)
# and paste each agent's ID here. Empty ID = that agent runs in mock mode.
LYZR_PRIVACY_GUARD_AGENT_ID=
LYZR_EXTRACTOR_AGENT_ID=
LYZR_CURATOR_AGENT_ID=
LYZR_NUDGER_AGENT_ID=
LYZR_ROUTER_AGENT_ID=
LYZR_RECALL_AGENT_ID=

# ---------- Qdrant (vector memory) ----------
# cloud.qdrant.io -> create free cluster -> copy cluster URL + API key.
# Leave both empty to use embedded local storage (backend/data/qdrant).
QDRANT_URL=
QDRANT_API_KEY=

# ---------- Omi (voice capture + phone notifications) ----------
# Omi phone app -> Apps/Explore -> Create App -> External Integration.
# Empty = notifications are shown on the dashboard only (dry-run).
OMI_APP_ID=
OMI_APP_SECRET=

# ---------- App ----------
# Your Omi user id (shown in the webhook ?uid= param); used for dashboard/simulator
VACHAN_DEFAULT_UID=demo-user
# fastembed (local model, recommended) or hash (no download, tests only)
VACHAN_EMBEDDER=fastembed
# India Standard Time = 330 minutes
VACHAN_TZ_OFFSET_MINUTES=330
VACHAN_CORS_ORIGINS=http://localhost:5173
